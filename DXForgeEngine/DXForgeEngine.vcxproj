  <!-- D3D12 Agility SDK (Microsoft.Direct3D.D3D12, issue #155). The package's targets add its headers (d3d12.h with
       D3D12_SDK_VERSION) to the include path. Its own copy (Content items) is turned off: this static library copies the
       runtime into its OutDir (x64\<Config>\D3D12\) itself, so EngineTest, EngineUnitTests and DXForgeEngineDLL (and the
       editor next to it), which all build into the same folder, and the game projects (which copy it from
       $(DXForge_LibraryPath)D3D12\) load the same version. d3d12SDKLayers.dll is the debug layer, so only Debug configs get it. -->
  <PropertyGroup>
    <Microsoft_Direct3D_D3D12_SkipLibraryCopy>true</Microsoft_Direct3D_D3D12_SkipLibraryCopy>
    <Microsoft_Direct3D_D3D12_SkipDebugLayerCopy>true</Microsoft_Direct3D_D3D12_SkipDebugLayerCopy>
    <DXForgeAgilitySdkBin>$(SolutionDir)packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\bin\x64\</DXForgeAgilitySdkBin>
  </PropertyGroup>
  <ItemGroup>
    <DXForgeAgilitySdkRuntime Include="$(DXForgeAgilitySdkBin)D3D12Core.dll" />
    <DXForgeAgilitySdkRuntime Include="$(DXForgeAgilitySdkBin)d3d12SDKLayers.dll" Condition="'$(UseDebugLibraries)' == 'true'" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="..\packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\Microsoft.Direct3D.D3D12.targets" Condition="Exists('..\packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\Microsoft.Direct3D.D3D12.targets')" />
  </ImportGroup>
  <Target Name="DXForgeCopyAgilitySdk" AfterTargets="Build">
    <Copy SourceFiles="@(DXForgeAgilitySdkRuntime)" DestinationFolder="$(OutDir)D3D12\" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
