    <Error Condition="!Exists('..\packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\Microsoft.Direct3D.D3D12.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\Microsoft.Direct3D.D3D12.props'))" />
    <Error Condition="!Exists('..\packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\Microsoft.Direct3D.D3D12.targets')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.Direct3D.D3D12.1.620.1\build\native\Microsoft.Direct3D.D3D12.targets'))" />
