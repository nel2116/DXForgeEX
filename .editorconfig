# このリポジトリの既存ファイルを実測した結果に基づく設定。
# 実測値: .cpp/.h = UTF-8 BOM + タブ / .cs/.xaml = UTF-8 BOM + 4スペース
#         .hlsl/.hlsli = UTF-8 BOM + 4スペース(fxc でコンパイルするものだけ BOM 無し。後述)
root = true

[*]
end_of_line = crlf
insert_final_newline = true

# C/C++: UTF-8 BOM が必須。
# BOM が無いと MSVC がローカルコードページ(Shift-JIS)と誤認し、日本語コメント以降の
# トークン列が壊れて、一見無関係な箇所でコンパイルエラーが連鎖する。
[*.{c,cpp,h,hpp}]
charset = utf-8-bom
indent_style = tab
indent_size = 4

[*.{cs,xaml}]
charset = utf-8-bom
indent_style = space
indent_size = 4

# HLSL: C++ と同じ UTF-8 BOM。
# エンジンのシェーダは DXC が読み(BOM の有無どちらも受け付ける)、CommonTypes.hlsli は
# SharedTypes.h 経由で MSVC も読むため、C++ と同じ理由で BOM が必須。
[*.{hlsl,hlsli}]
charset = utf-8-bom
indent_style = space
indent_size = 4

# fxc でコンパイルする HLSL だけは BOM 無し。fxc (ContentTools/CompileShaders.cmd、WPF のピクセル
# シェーダ、Visual Studio の HLSL ビルドの SM5.x) は BOM 付きを
# "error X3000: Illegal character in shader file" で拒否する。
[{ContentTools,DXForgeEditor}/**.{hlsl,hlsli}]
charset = utf-8

[*.ps1]
charset = utf-8-bom
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
indent_style = space
indent_size = 2

[*.{sln,vcxproj,vcxproj.filters,csproj,props,targets}]
indent_style = space
indent_size = 2
