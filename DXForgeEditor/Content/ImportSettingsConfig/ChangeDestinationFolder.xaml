<UserControl x:Class="DXForgeEditor.Content.ChangeDestinationFolder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DXForgeEditor.Content"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type={x:Type local:AssetProxy}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:ContentSubfolderConverter x:Key="contentSubfolderConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding FileInfo.Name, StringFormat=' {0} の保存先フォルダは'}"
                   TextTrimming="CharacterEllipsis" d:Text="file.extの保存先フォルダは" Margin="0,0,0,5"/>
        <Border BorderBrush="{StaticResource Editor.Window.GrayBrush6}" BorderThickness="1" CornerRadius="3" Grid.Row="1">
            <DockPanel Margin="5">
                <Button Content="変更" DockPanel.Dock="Right" Click="OnChangeDestinationFolder_Button_Click"/>
                <TextBlock Text="{Binding DestinationFolder, Converter={StaticResource contentSubfolderConverter}}"
                           TextTrimming="CharacterEllipsis" d:Text="/Meshes/TreeModels"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
