<UserControl x:Class="DXForgeEditor.Editors.TransformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DXForgeEditor.Editors"
             xmlns:vm="clr-namespace:DXForgeEditor.Components"
             xmlns:utl="clr-namespace:DXForgeEditor.Utilities.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MSTransform,IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
    </UserControl.Resources>
    <!-- NOTE: TargetNullValue='' がないと、複数の値(float? の null)が VectorBox の double? に渡らず 0 になる(Primal Day 086 と同じ指定) -->
    <local:ComponentView Header="Transform">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Position" Grid.Column="0" Grid.Row="0"/>
            <utl:VectorBox X="{Binding PosX, TargetNullValue=''}" Y="{Binding PosY, TargetNullValue=''}" Z="{Binding PosZ, TargetNullValue=''}" Grid.Column="1" Grid.Row="0"
                           PreviewMouseLeftButtonDown="OnPosition_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnPosition_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnPosition_VectorBox_ValueChanged"/>

            <TextBlock Text="Rotation" Grid.Column="0" Grid.Row="1"/>
            <utl:VectorBox X="{Binding RotX, TargetNullValue=''}" Y="{Binding RotY, TargetNullValue=''}" Z="{Binding RotZ, TargetNullValue=''}" Grid.Column="1" Grid.Row="1"
                           PreviewMouseLeftButtonDown="OnRotation_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnRotation_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnRotation_VectorBox_ValueChanged"/>

            <TextBlock Text="Scale" Grid.Column="0" Grid.Row="2"/>
            <utl:VectorBox X="{Binding ScaleX, TargetNullValue=''}" Y="{Binding ScaleY, TargetNullValue=''}" Z="{Binding ScaleZ, TargetNullValue=''}" Grid.Column="1" Grid.Row="2"
                           PreviewMouseLeftButtonDown="OnScale_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnScale_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnScale_VectorBox_ValueChanged"/>
        </Grid>
    </local:ComponentView>
</UserControl>
