<UserControl x:Class="DXForgeEditor.Editors.TransformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DXForgeEditor.Editors"
             xmlns:vm="clr-namespace:DXForgeEditor.Components"
             xmlns:utl="clr-namespace:DXForgeEditor.Utilities.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MSTransform,IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}"/>
    </UserControl.Resources>
    <!-- NOTE: TargetNullValue='' がないと、複数の値(float? の null)が VectorBox の double? に渡らず 0 になる(Primal Day 086 と同じ指定) -->
    <!-- NOTE: 行(Position、Local Offset、Rotation、Rotation Offset、Scale)は Primal Day 086 の TransformComponentView と同じ。
               オフセットの行は確定のたびに 0 に戻る(docs/design/transform-editing.md) -->
    <local:ComponentView Header="Transform">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Position" Grid.Column="0" Grid.Row="0"/>
            <utl:VectorBox X="{Binding PosX, TargetNullValue=''}" Y="{Binding PosY, TargetNullValue=''}" Z="{Binding PosZ, TargetNullValue=''}" Grid.Column="2" Grid.Row="0"
                           PreviewMouseLeftButtonDown="OnPosition_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnPosition_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnPosition_VectorBox_ValueChanged"/>

            <TextBlock Text="Local Offset" Grid.Column="0" Grid.Row="1" ToolTip="エンティティのローカル軸(right/up/front)に沿って動かす量"/>
            <utl:VectorBox X="{Binding LocalPosX}" Y="{Binding LocalPosY}" Z="{Binding LocalPosZ}" Grid.Column="2" Grid.Row="1"
                           PreviewMouseLeftButtonDown="OnPosition_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnPosition_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnLocalPosition_VectorBox_ValueChanged"/>

            <TextBlock Text="Rotation" Grid.Column="0" Grid.Row="2"/>
            <utl:VectorBox X="{Binding RotX, TargetNullValue=''}" Y="{Binding RotY, TargetNullValue=''}" Z="{Binding RotZ, TargetNullValue=''}" Grid.Column="2" Grid.Row="2"
                           PreviewMouseLeftButtonDown="OnRotation_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnRotation_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnRotation_VectorBox_ValueChanged"/>

            <TextBlock Grid.Column="0" Grid.Row="3">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource LightTextBlockStyle}">
                        <Setter Property="Text" Value="Local Offset"/>
                        <Setter Property="ToolTip" Value="エンティティのローカル軸について回す角度(度)"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocalRotation}" Value="False">
                                <Setter Property="Text" Value="World Offset"/>
                                <Setter Property="ToolTip" Value="ワールド軸について回す角度(度)"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ToggleButton Content="L" IsChecked="{Binding IsLocalRotation}" Width="20" Margin="5,0" Grid.Column="1" Grid.Row="3"
                          ToolTip="オン: ローカル軸について回す / オフ: ワールド軸について回す"/>
            <utl:VectorBox X="{Binding RotOffsetX}" Y="{Binding RotOffsetY}" Z="{Binding RotOffsetZ}" Grid.Column="2" Grid.Row="3"
                           PreviewMouseLeftButtonDown="OnRotation_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnRotation_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnRotationOffset_VectorBox_ValueChanged"/>

            <TextBlock Text="Scale" Grid.Column="0" Grid.Row="4"/>
            <ToggleButton Content="U" IsChecked="{Binding IsUniformScale}" Width="20" Margin="5,0" Grid.Column="1" Grid.Row="4"
                          ToolTip="オン: 1 つの成分を変えると 3 つとも同じ値にする"/>
            <utl:VectorBox X="{Binding ScaleX, TargetNullValue=''}" Y="{Binding ScaleY, TargetNullValue=''}" Z="{Binding ScaleZ, TargetNullValue=''}" Grid.Column="2" Grid.Row="4"
                           PreviewMouseLeftButtonDown="OnScale_VectorBox_PreviewMouse_LBD"
                           GotKeyboardFocus="OnScale_VectorBox_GotKeyboardFocus"
                           ValueChanged="OnScale_VectorBox_ValueChanged"/>
        </Grid>
    </local:ComponentView>
</UserControl>
