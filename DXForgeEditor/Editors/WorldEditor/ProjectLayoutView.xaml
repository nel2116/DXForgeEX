<UserControl x:Class="DXForgeEditor.Editors.ProjectLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DXForgeEditor.Editors"
             xmlns:proj="clr-namespace:DXForgeEditor.GameProject"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=proj:Project}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Hierarchy" Foreground="{StaticResource Editor.FontBrush}" FontSize="14"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Scenes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource CustomExpanderStyle}" IsExpanded="{Binding IsActive, Mode=OneWay}">
                            <Expander.Header>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LightTextBlockStyle}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="renameTextBox" Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                                     Style="{StaticResource TextBoxStyle_WithRename}" Tag="{Binding RenameCommand}" Visibility="Collapsed"/>
                                        </Grid>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveSceneCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="10,0" Focusable="false"/>
                                        <Button Content="Rename" Click="OnRenameScene_Button_Click" Tag="{Binding ElementName=renameTextBox}"/>
                                        <Button Content="+" IsEnabled="{Binding IsActive}"
                                                Click="OnAddGameEntity_Button_Click" Margin="10,0"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ListBox Style="{StaticResource ListBoxNoScrollStyle}" ItemsSource="{Binding GameEntities}" IsEnabled="{Binding IsActive}"
                                     SelectionMode="Extended" AllowDrop="True" MinHeight="48" HorizontalContentAlignment="Stretch"
                                     SelectionChanged="OnGameEntities_ListBox_SelectionChanged" Loaded="OnGameEntities_ListBox_Loaded"
                                     Drop="OnGameEntities_ListBox_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" MinHeight="24">
                                            <TextBlock Text="{Binding Name}" Margin="4,0" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource RemoveButtonStyle}"
                                                    x:Name="removeButton" Visibility="Collapsed" Margin="5,0" VerticalAlignment="Center"
                                                    Command="{Binding ParentScene.RemoveGameEntityCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Visibility" TargetName="removeButton" Value="Visible"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
