<Project Sdk="Microsoft.NET.Sdk">

  <!-- コマンドラインのアセット・インポーター(Issue #10)。エディタ(DXForgeEditor)の Content のコードをそのまま使い、
       エディタと同じ .asset を書き出す。出力先はエディタと同じ x64\<構成>\ で、そこにある ContentTools.dll を使う。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- エディタのアイコン生成(GeometryView の描画)とログが WPF の Application/Dispatcher を使うため -->
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <BaseOutputPath>../</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>DebugEditor;ReleaseEditor</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugEditor|x64'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ReleaseEditor|x64'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DXForgeEditor\DXForgeEditor.csproj" />
  </ItemGroup>
</Project>
